{
  "name": "nanobanana-mcp-server",
  "version": "1.0.12",
  "type": "module",
  "description": "MCP server for Nano Banana extension",
  "main": "dist/index.js",
  "scripts": {
    "build": "bun run build:bundle",
    "build:tsc": "tsc",
    "build:bundle": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && bun build src/index.ts --outdir dist --target node --minify",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "echo \"No tests specified\" && exit 0"
  },
  "dependencies": {
    "@google/genai": "^1.17.0",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "jpeg-js": "^0.4.4",
    "pngjs": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/jpeg-js": "^0.3.7",
    "@types/pngjs": "^6.0.5",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
