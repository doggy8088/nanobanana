{
  "name": "@willh/nano-banana-mcp",
  "version": "1.0.24",
  "type": "module",
  "description": "MCP server for Nano Banana extension",
  "main": "dist/index.js",
  "bin": {
    "nano-banana-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/doggy8088/nanobanana.git"
  },
  "author": "Will Huang",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/doggy8088/nanobanana/issues"
  },
  "homepage": "https://github.com/doggy8088/nanobanana#readme",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun run build:bundle",
    "build:tsc": "tsc",
    "build:bundle": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && bun build src/index.ts --outdir dist --target node --minify && node -e \"const fs=require('fs');const f='dist/index.js';const c=fs.readFileSync(f,'utf8');fs.writeFileSync(f,'#!/usr/bin/env node\\n'+c)\"",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "node -e \"require('fs').rmSync('dist-test',{recursive:true,force:true})\" && tsc -p tsconfig.test.json && node --test dist-test/tests/*.test.js"
  },
  "dependencies": {
    "@google/genai": "^1.17.0",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "jpeg-js": "^0.4.4",
    "pngjs": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/jpeg-js": "^0.3.7",
    "@types/pngjs": "^6.0.5",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
